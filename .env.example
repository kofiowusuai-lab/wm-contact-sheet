# App auth
# Hosted API routes require Basic Auth when deployed.
# Local harness mode works without setting these.
BASIC_AUTH_USERNAME=review
BASIC_AUTH_PASSWORD=replace-with-private-password

# Local harness storage
WM_STORAGE=local
WM_DATA_DIR=.wm-data

# Supabase storage/data
# Optional. Leave blank for the local agent harness.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_BUCKET=wm-contact-sheet
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# AI, media, and music providers
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-gemini-key
FAL_KEY=replace-with-fal-key
FAL_ADMIN_KEY=replace-with-fal-admin-key
ELEVENLABS_API_KEY=replace-with-elevenlabs-key
ELEVENLABS_API_KEY_FALLBACK=
ELEVENLABS_API_KEY_FALLBACK_2=
ELEVENLABS_API_KEY_FALLBACK_3=
JAMENDO_CLIENT_ID=replace-with-jamendo-client-id
